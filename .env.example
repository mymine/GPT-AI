# ---- Server ----
PORT=3000

# The gateway reuses the /chat/vN handlers in-process (no ports, no self-HTTP),
# so it works unchanged on serverless platforms such as Vercel.

# ---- OpenAI-compatible gateway ----
# Optional: require this key on every /v1/* request (send it as `Authorization: Bearer <key>`).
# Leave empty to disable auth (upstream provider keys are still forwarded as-is).
# OPENAI_COMPAT_KEY=sk-your-local-key

# Default provider (v1..v15) used when the requested `model` cannot be mapped.
# DEFAULT_PROVIDER=v1

# Upstream request timeout in ms, and an artificial per-chunk delay for streaming (0 = none).
# UPSTREAM_TIMEOUT_MS=120000
# STREAM_DELAY_MS=0

# ---- Upstream provider keys (only needed for the providers that require one) ----
# /chat/v1  (Pollinations)
# POLLINATIONS_API_KEY=
# /chat/v2  (OpenRouter)
# OPENROUTER_API_KEY=
# /chat/v7  (FreedomGPT)
# FREEDOMGPT_API_KEY=
# /chat/v12 (api.airforce)
# AIRFORCE_API_KEY=
